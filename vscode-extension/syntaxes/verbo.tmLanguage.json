{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Verbo",
  "scopeName": "source.vrb",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#function-declarations" },
    { "include": "#entity-declarations" },
    { "include": "#server-declarations" },
    { "include": "#function-calls" },
    { "include": "#articles" },
    { "include": "#copula-verbs" },
    { "include": "#keywords-control" },
    { "include": "#keywords-concurrency" },
    { "include": "#keywords-server" },
    { "include": "#types" },
    { "include": "#connectors" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.vrb",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vrb",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vrb",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.vrb",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.vrb",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.vrb",
          "match": "\\b(Verdadeiro|verdadeiro|Falso|falso)\\b"
        },
        {
          "name": "constant.language.null.vrb",
          "match": "\\b(Nulo|nulo)\\b"
        }
      ]
    },
    "function-declarations": {
      "match": "\\b(Para|para)\\s+([A-Za-zÀ-ÖØ-öø-ÿ_][A-Za-zÀ-ÖØ-öø-ÿ0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.function.vrb" },
        "2": { "name": "entity.name.function.vrb" }
      }
    },
    "entity-declarations": {
      "match": "\\b(Entidade|entidade)\\s+([A-Za-zÀ-ÖØ-öø-ÿ_][A-Za-zÀ-ÖØ-öø-ÿ0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.entity.vrb" },
        "2": { "name": "entity.name.type.class.vrb" }
      }
    },
    "server-declarations": {
      "match": "\\b(Servidor|servidor)\\s+(rota)\\s+(GET|POST|PUT|DELETE)\\b",
      "captures": {
        "1": { "name": "support.class.server.vrb" },
        "2": { "name": "keyword.other.route.vrb" },
        "3": { "name": "constant.language.http-method.vrb" }
      }
    },
    "function-calls": {
      "match": "\\b([A-Za-zÀ-ÖØ-öø-ÿ_][A-Za-zÀ-ÖØ-öø-ÿ0-9_]*)\\s+(com)\\b",
      "captures": {
        "1": { "name": "entity.name.function.call.vrb" },
        "2": { "name": "keyword.other.with.vrb" }
      }
    },
    "articles": {
      "patterns": [
        {
          "name": "storage.modifier.immutable.vrb",
          "match": "\\b(O|A|Os|As|o|a|os|as)\\b"
        },
        {
          "name": "storage.modifier.mutable.vrb",
          "match": "\\b(Um|Uma|Uns|Umas|um|uma|uns|umas)\\b"
        },
        {
          "name": "variable.language.demonstrative.vrb",
          "match": "\\b(Este|Esta|Estes|Estas|este|esta|estes|estas|Aquele|Aquela|Aqueles|Aquelas|aquele|aquela|aqueles|aquelas)\\b"
        }
      ]
    },
    "copula-verbs": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.static.vrb",
          "match": "\\b(É|é)\\b"
        },
        {
          "name": "keyword.operator.assignment.state.vrb",
          "match": "\\b(Está|está)\\b"
        }
      ]
    },
    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control.vrb",
          "match": "\\b(Se|se|for|então|Então|Senão|senão|Repita|repita|vezes|cada|em|Enquanto|enquanto|Retorne|retorne|Exibir|exibir|Dado|dado|Incluir|incluir|usando)\\b"
        }
      ]
    },
    "keywords-concurrency": {
      "patterns": [
        {
          "name": "keyword.control.concurrency.vrb",
          "match": "\\b(Simultaneamente|simultaneamente|Aguarde|aguarde|Canal|canal|Enviar|enviar|Receber|receber|Tente|tente|Capture|capture|Sinalize|sinalize|contendo|Contendo|novo|Novo)\\b"
        }
      ]
    },
    "keywords-server": {
      "patterns": [
        {
          "name": "support.class.server.vrb",
          "match": "\\b(Servidor|servidor|Endereço|endereço|Endereco|endereco|Porta|porta|Local|local|Externo|externo|Rota|rota|Iniciar|iniciar|Rodar|rodar)\\b"
        },
        {
          "name": "constant.language.http-method.vrb",
          "match": "\\b(GET|POST|PUT|DELETE)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.vrb",
          "match": "\\b(Texto|Inteiro|Decimal|Lógico|Logico|Lista|Canal)\\b"
        }
      ]
    },
    "connectors": {
      "patterns": [
        {
          "name": "keyword.operator.preposition.vrb",
          "match": "\\b(de|do|da|dos|das|ao|aos|no|na|nos|nas|pelo|pela|pelos|pelas|por|que)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.textual.vrb",
          "match": "\\b(menor|maior|igual|idêntico|identico|diferente)\\b"
        },
        {
          "name": "keyword.operator.logical.vrb",
          "match": "\\b(não|Não)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.textual.vrb",
          "match": "\\b(e|mais|soma|menos|subtrai|multiplica|divide|porcentagem|módulo|modulo)\\b"
        },
        {
          "name": "keyword.operator.comparison.vrb",
          "match": "(==|!=)"
        },
        {
          "name": "keyword.operator.arithmetic.vrb",
          "match": "(\\+|\\-|\\*|\\/|%)"
        },
        {
          "name": "keyword.operator.assignment.vrb",
          "match": "(=)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.period.vrb",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.colon.vrb",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.vrb",
          "match": ","
        },
        {
          "name": "punctuation.section.parens.vrb",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.vrb",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.braces.vrb",
          "match": "[{}]"
        }
      ]
    }
  }
}

